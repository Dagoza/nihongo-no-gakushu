# Nihongo Master - Configuración de Supabase para Sincronización Multi-Dispositivo
# Copia este archivo a `.env.local` y reemplaza los valores con los de tu proyecto de Supabase.
# O bien, puedes configurarlos directamente desde la pestaña "Mi Progreso" en la app.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
